# Endereço público onde o site será publicado (termine com /).
# Usado nas prévias de link (WhatsApp, redes sociais), no sitemap e no Google.
# ⚠️ Confirme o endereço definitivo com a equipe de TI da Prefeitura.
VITE_ENDERECO_SITE=https://www.saoluis.ma.gov.br/mercado-central/

# Caminho da pasta do site no servidor (termine com /). Usado pela página 404
# para achar os arquivos mesmo em endereços que não existem.
# Na raiz do domínio: /   ·  Numa subpasta: /mercado-central/   ·  Teste local: ./
VITE_CAMINHO_BASE=./

# true = mostra a faixa "versão de demonstração" (usado no GitHub Pages)
VITE_DEMONSTRACAO=false
